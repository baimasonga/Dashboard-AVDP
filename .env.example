# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CARTO_TOKEN: Access token for CARTO Maps API, vector basemaps, and spatial analytics.
# User-configured or loaded for authenticated CARTO raster and vector tile streaming.
CARTO_TOKEN=
VITE_CARTO_TOKEN=

# CARTO_API_BASE_URL: Base URL for CARTO API platform services (Maps API, SQL queries, spatial engine).
CARTO_API_BASE_URL="https://gcp-us-east1.api.carto.com"
VITE_CARTO_API_BASE_URL="https://gcp-us-east1.api.carto.com"


# Dashboard analytical data source.
# Keep "demo" while using bundled fictitious data. Set to "live" only when an
# approved AVDP read-only data service is available.
VITE_DASHBOARD_DATA_MODE="demo"
# In live mode this base URL must expose GET /datasets using the documented Dataset contract.
VITE_DASHBOARD_DATA_API_URL=
